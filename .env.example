# GEMINI_PROXY_URL: HTTPS base URL of a backend proxy that forwards
# `POST v1beta/models/<model>:generateContent` requests to the Gemini API.
# The proxy holds the Gemini API key server-side and authenticates app users.
# Do NOT put a Gemini API key in this file: everything here is compiled into the APK.
# If left as the placeholder, the app runs in offline heuristic mode.
GEMINI_PROXY_URL=https://MY_GEMINI_PROXY_URL
